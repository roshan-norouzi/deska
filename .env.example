# Database (Docker PostgreSQL on port 5433)
DATABASE_URL=postgresql://deska:deska123@localhost:5433/deska_erp
# JWT
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Tenancy
TENANT_MODE=multi
DEFAULT_TENANT_SLUG=default

# App URLs
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
PUBLIC_URL=http://localhost
APP_VERSION=1.0.0
# Optional prebuilt image namespace, e.g. ghcr.io/USERNAME/deska; leave empty for local build
IMAGE_PREFIX=
BASE_PATH=
CORS_ORIGIN=http://localhost:3000
PORT=3001

# Storage
STORAGE_TYPE=local
STORAGE_PATH=./uploads
# Seed admin (first run)
SEED_ADMIN_EMAIL=admin@deska.local
SEED_ADMIN_PASSWORD=Admin@1234
SEED_ADMIN_NAME=مدیر سیستم
